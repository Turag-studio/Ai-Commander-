# === AI Commander OS — environment configuration ===
# Copy to .env.local (apps/web) and fill in the integrations you have.
# Every integration below is optional at boot time: agents fall back to
# clearly-labeled mock data when credentials are missing so the dashboard
# always runs end to end.

# --- AI providers (Commander planner + content/design/video agents) ---
# Cloud providers are OPTIONAL — the AI Model Manager always tries local
# Ollama models first and only falls back to these when Ollama is unavailable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Shopify (Shopify Agent) ---
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2024-10
# Signing secret from the webhook subscription (Shopify Admin > Notifications, or
# the value returned when the app registers webhooks) — verifies inbound webhooks.
SHOPIFY_WEBHOOK_SECRET=
# Public domain this app is reachable at, used as the webhook callback URL
# (https://$DOMAIN_NAME/api/webhooks/shopify) and set by the Setup Wizard.
DOMAIN_NAME=

# --- Local AI models (AI Model Manager — tried first, before any cloud provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Marketplaces (Marketplace Agent) ---
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
FLIPKART_API_KEY=
MEESHO_API_KEY=
ETSY_API_KEY=

# --- Social platforms (Social Media Agent) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
PINTEREST_ACCESS_TOKEN=
YOUTUBE_API_KEY=
LINKEDIN_ACCESS_TOKEN=

# --- Analytics (Analytics Agent) ---
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_ADS_DEVELOPER_TOKEN=
META_ADS_ACCESS_TOKEN=

# --- Local AI image generation (Design Agent) ---
# Any Automatic1111 / ComfyUI-compatible instance exposing /sdapi/v1/txt2img.
IMAGE_GEN_API_URL=
# Any rembg-compatible background removal service (POST image, get PNG back).
BACKGROUND_REMOVAL_API_URL=

# --- Storage ---
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# --- Database / cache / memory ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
# Memory Agent uses Qdrant when set, else falls back to an in-memory vector store.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=ai_commander_memory

# --- Auth ---
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Messaging / notifications ---
TELEGRAM_BOT_TOKEN=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
